# — local / build state (never tracked) —
node_modules
.tmp/
REVIEW_*.md
graphify-out/
.codegraph/
__pycache__/
vitest-report.json

# — .pi: the TOOLS are tracked for contributor parity; session state and
# local config stay local. Any NEW .pi state dir is ignored by default. —
.pi/*
!.pi/skills/
!.pi/extensions/

