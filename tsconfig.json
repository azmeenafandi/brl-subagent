{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "module": "esnext",
    "target": "es2024",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  // `.pi/extensions/**` is dev tooling (tracked, jiti-loaded, never shipped), but
  // it still has to typecheck: drift there otherwise surfaces only at runtime.
  // One config, one include list — the extension imports resolve from the root
  // `node_modules`, so a second config would only be drift risk (issue #394).
  "include": ["src/**/*.ts", ".pi/extensions/**/*.ts"],
  "exclude": ["src/__tests__"]
}
