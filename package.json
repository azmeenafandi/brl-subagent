{
  "name": "brl-subagent",
  "version": "2.3.2",
  "description": "Subagent extension for pi with configurable model and thinking mode via selection UI",
  "keywords": [
    "pi-package"
  ],
  "files": [
    "src/",
    "presets/",
    "templates/",
    "README.md",
    "LICENSE",
    "!src/__tests__/"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "^0.84.2",
    "@earendil-works/pi-ai": "^0.84.2",
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "@earendil-works/pi-tui": "^0.84.2",
    "jiti": "^2.7.0",
    "typebox": "^1.3.15",
    "typescript": "^5.6.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "nanoid": "^3.3.17"
  }
}
